[user]
	name = Masahiro Furudate
	email = 178inaba.git@gmail.com
[core]
	editor = vim
	pager = diff-so-fancy | less --tabs=4 -RF
	quotepath = false
	# core.excludesFile を明示しないと XDG_CONFIG_HOME を設定したマシンで
	# 参照先が動き、stow の配置先 (~/.config/git/ignore) が読まれなくなる。
	# ignore が効かなくなってもエラーは出ず status が汚れるだけで気づけない
	# ため、デフォルトと同値でも明示する。
	excludesFile = ~/.config/git/ignore
[interactive]
	diffFilter = diff-so-fancy --patch
[color]
	ui = true
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[url "git@bitbucket.org:"]
	insteadOf = https://bitbucket.org/
[url "git@github.com:"]
	insteadOf = https://github.com/
[alias]
	cc = checkout .

	# codereview
	change = codereview change
	gofmt = codereview gofmt
	mail = codereview mail
	pending = codereview pending
	submit = codereview submit
	sync = codereview sync
[http]
	cookiefile = ~/.gitcookies
[init]
	defaultBranch = main
[branch]
	# autoSetupMerge = simple は git 2.37 以降が必須（古い git は無視せず
	# bad boolean config value で全 git コマンドが死ぬ）。始点が同名の
	# remote-tracking branch のときだけ upstream を設定するので、
	# `git switch -c feature/x origin/main` が origin/main を upstream として
	# 引き継ぐのを防ぐ。これにより引数なし push が名前不一致で落ちなくなり、
	# `@{u}` の解決失敗が「一度も push していない」ことの判定として使える。
	# その判定の消費者は claude/.claude/skills/git-rebase/SKILL.md のステップ15。
	autoSetupMerge = simple
[pull]
	rebase = false
[push]
	# default = simple は git 2.0 以降の既定と同値だが、許可ルール
	# `Bash(git push)` が「引数なし push は現在ブランチと同名のリモート
	# ブランチだけを進める」ことに依存しているため、既定任せにせず明示する
	# （core.excludesFile と同じ「既定と同値でも明示する」理由）。
	# autoSetupRemote は upstream 未設定のときだけ初回 push でリモート
	# ブランチを作って upstream を張る。
	# 両キーを前提にしている許可ルール（完全一致で維持する理由と、広げたときに
	# 無言で防御が外れる仕組み）は claude/.claude/rules/hooks-design.md の
	#「許可ルールの設計意図」を参照。
	default = simple
	autoSetupRemote = true
[fetch]
	prune = true
# remote.origin.* をここに直接書くと remote 未設定のリポジトリにも幽霊 origin が
# 現れる（git remote に列挙され fetch が silent no-op 化する）ため、
# remote が実在するリポジトリだけに適用する。hasconfig はリモート名では絞れない
# （remote.*.url の * は固定構文）ので、origin 以外のリモートしか無いリポジトリに
# 幽霊 origin が出る残存ケースは許容
[includeIf "hasconfig:remote.*.url:**"]
	path = ~/.gitconfig.remote
[include]
	path = ~/.gitconfig.local
