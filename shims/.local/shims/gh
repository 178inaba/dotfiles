#!/bin/bash

# gh の書き込み系サブコマンドの事故防止ラッパー（PATH 上の shim）
#
# ルール1: 対象リポジトリがコマンド上で明示されていることを必須化する
#   別リポジトリへ調査目的で cd した状態で、cwd の git remote が
#   暗黙参照されることによる「意図しないリポジトリへの Issue/PR 作成」
#   事故を防ぐ。守るべき不変条件は「対象リポジトリが明示されていること」で、
#   -R はその十分条件の1つに過ぎない。gh が受け付けるリポジトリ指定の形は
#   noun ごとに異なるため、判定も noun ごとに分ける:
#     - gh repo edit/delete/archive/unarchive/sync: 最初の位置引数が
#       OWNER/REPO・HOST/OWNER/REPO・リポジトリ URL であること。これらは -R を
#       持たず、-R を持たないサブコマンドでは GH_REPO も効かない（gh は GH_REPO を
#       -R の既定値として解決するため）。bare な REPO は gh が認証ユーザーを
#       補完するので、cwd 解決と同じく暗黙とみなして許可しない
#     - gh repo rename: 位置引数は新しいリポジトリ名なので -R または GH_REPO
#     - gh issue/pr の selector を取る verb: -R / GH_REPO に加え、位置引数が
#       Issue/PR の完全 URL でもよい。ブランチ名にもスラッシュが含まれるため
#       「スラッシュを含むか」ではなく URL の形そのものを判定する
#     - gh issue create / gh pr create / gh release / gh label: -R または GH_REPO
#   verb 直後の --help はヘルプ表示で write ではないため免除する。-h は verb に
#   よって値取りフラグ（gh repo edit の --homepage 等）なので、その場合は免除しない。
#
# ルール2: 複数行の本文を --body/-b で渡すことを禁止する（--body-file へ誘導）
#   --body "$(cat <<'EOF' ... EOF)" のような引用符レイヤの重なりが誤エスケープを
#   誘発し、本文にリテラルの \ が残る事故を防ぐ。判定は --body の値そのものに
#   改行が含まれるかで、他の引数の複数行値は撃たない。
#   「壊れた本文の検出」ではなく「禁止」なのは、shim が見るのはシェルが処理し終えた
#   後の文字列で誤エスケープを事後にしか検出できず、かつコードの話題では \n という
#   リテラルが正当に現れるため。引用符レイヤを組ませない側が強い。
#
# ルール3: 本文中の項番目的とみられる素の #N を検出してブロックする
#   素の #数字 は GitHub で Issue/PR への自動リンクになるため、項目の
#   番号付け（指摘 #1, #2, ...）に使うと無関係な Issue/PR へ参照通知が
#   飛ぶ事故が起きる。#1〜#9 が3種類以上あれば項番とみなす。
#   GitHub がリンク化しない形は除外する: コードスパン・fenced code block 内、
#   数字の直後に英数字が続く形（#12 等の複数桁は実参照の可能性が高く、
#   #1a2b3c 等の hex カラー・#1st 等の序数はそもそも参照でない）。
#   OWNER/REPO#N 形式（直前が英数字）も意図的な参照とみなして除外する。
#   既知の限界: 未クローズの fence 以降は検出されない（fail-open 側）。
#
# ルール4: PR 本文中のバッククォート付き closing keyword を検出してブロックする
#   コードスパン・fenced code block 内の Closes/Fixes/Resolves #N は GitHub が
#   closing keyword として解釈せず、PR をマージしても Issue が自動 close されない
#   （open のまま残る事故）。対象は gh pr create / gh pr edit のみ
#   （closing keyword が効くのは PR 本文だけで、Issue 本文・コメントでは
#   単なるリンクにしかならないため）。キーワードは大文字小文字不問、
#   OWNER/REPO#N 形式も対象。番号なしのプレースホルダ（`Closes #N` 等）は
#   引用・文書化用途として許容する。
#
#   これらのルールは元々 PreToolUse フックがコマンド文字列へのパターンマッチで
#   判定していたが、文字列からは「実際に何が実行されるか」を決められず、見逃し
#   （1つの -R が同じ行の全 write を覆う）と過剰ブロック（引用符・heredoc 内の
#   リテラルを write とみなす、本文と無関係な heredoc の改行をルール2 が拾う）の
#   両方が出ていた。shim はシェルが渡す argv を直接読むため、どちらも成立しない。
#
# 仕様:
#   - 入力: 実行された gh の argv と、環境変数 GH_REPO / CLAUDECODE / GH_BIN
#   - read サブコマンドは判定より前に exec する（調査・レビューに負荷を足さない）
#   - CLAUDECODE 未設定なら判定せず exec する（対話シェルの挙動は変えない）
#   - 違反していれば実体の gh を実行せず exit 78
#   - それ以外は exec するので、exit status・stdin/stdout/stderr・シグナルは素通しになる
#   - fail closed: 判定を終える前に抜けた場合（内部エラー）も exec しない
#   - 唯一の例外として、本文ファイルが読めない場合はルール3・4 を fail open で
#     スキップする（ファイルはこれから書かれることがあり、読めない本文は走査できない）

set -eEuo pipefail

# gh が文書化している exit status（0 成功 / 1 エラー / 2 中断 / 4 要認証）とも、
# シェル予約の 126・127 とも衝突しない値。呼び出し側がブロックと gh 自身の失敗を
# 区別できるように、1つに固定する
block_exit=78

# exec に成功するとプロセスが置き換わるのでこのトラップは走らない。走ったということは
# 判定を終える前に抜けた = 書き込みは実行されていないので、終了状態をブロックに揃える
on_unexpected_exit() {
  local status=$?
  if [ "$status" -eq "$block_exit" ]; then
    exit "$status"
  fi
  cat >&2 <<EOF
gh shim: 判定中に内部エラーが発生したため、gh を実行しませんでした（内部 exit status: ${status}）。

これは shim (~/.local/shims/gh) 側の不具合です。
緊急の回避策: PATH から ~/.local/shims を外すか、実体の gh を絶対パスで呼んでください。
EOF
  exit "$block_exit"
}
trap on_unexpected_exit EXIT

# パスのディレクトリ部分を取り出す。外部 dirname を fork しないのは、この経路が
# read サブコマンドを含む全 gh 呼び出しで通るため（結果は dir_part へ格納する）。
dir_part=''
set_dir_part() {
  case $1 in
    */*) dir_part=${1%/*} ;;
    *) dir_part='.' ;;
  esac
}

set_dir_part "${BASH_SOURCE[0]}"
self_dir=$(cd -P "$dir_part" && pwd -P)

# 実体の gh を探す。GH_BIN はこのリポジトリ既存のスタブ差し替え規約
# （statusline.sh・issue-hierarchy.sh 等）で、テストが実 gh に触れずに済むのはこれのため。
# 自分自身を指す GH_BIN（export された GH_BIN=gh 等）は無限再帰になるので無視する。
# 比較を物理パスで行うのは、stow 後の ~/.local/shims がリポジトリへの symlink で、
# リポジトリ内の実体パスから起動された場合に論理パスが一致しないため。
real_gh=''
resolve_real_gh() {
  local resolved candidate dir

  if [ -n "${GH_BIN:-}" ]; then
    if resolved=$(command -v -- "$GH_BIN" 2>/dev/null) && [ -n "$resolved" ]; then
      set_dir_part "$resolved"
      dir=$(cd -P "$dir_part" 2>/dev/null && pwd -P) || dir=''
      if [ "$dir" != "$self_dir" ]; then
        real_gh=$resolved
        return 0
      fi
    fi
  fi

  # type -aP は組み込みで PATH 上の gh を前から順に列挙する。PATH の全エントリを
  # 物理パス化してから gh の有無を見るより、実際に gh がある候補（通常は自分と実体の
  # 2 件）だけを物理パス化する方がサブシェルの数が少なくて済む
  while IFS= read -r candidate; do
    if [ -z "$candidate" ]; then
      continue
    fi
    set_dir_part "$candidate"
    dir=$(cd -P "$dir_part" 2>/dev/null && pwd -P) || dir=''
    if [ -n "$dir" ] && [ "$dir" != "$self_dir" ]; then
      real_gh=$candidate
      return 0
    fi
  done < <(type -aP gh 2>/dev/null)
  return 1
}

if ! resolve_real_gh; then
  printf 'gh shim: 実体の gh が見つかりません（GH_BIN と PATH を確認してください）。\n' >&2
  exit "$block_exit"
fi

# 書き込み系とみなす verb の一覧（noun ごと）。リポジトリ指定が文脈上意味を持たない
# もの（gh repo create / fork / set-default、gh repo clone 等）は対象外とする。
# read fast-path もこのリストで判定するので、「書き込みか」の定義はファイル内で1つ
issue_write_verbs='create|comment|edit|close|reopen|delete|develop|lock|unlock|pin|unpin|transfer'
pr_write_verbs='create|comment|edit|close|reopen|lock|unlock|merge|ready|revert|review|update-branch|checkout'
release_write_verbs='create|edit|delete|upload|delete-asset'
repo_write_verbs='edit|delete|archive|unarchive|rename|sync'
label_write_verbs='create|edit|delete|clone'

argv_all=("$@")
noun=${1:-}
verb=${2:-}

case $noun in
  issue) write_verbs=$issue_write_verbs ;;
  pr) write_verbs=$pr_write_verbs ;;
  release) write_verbs=$release_write_verbs ;;
  repo) write_verbs=$repo_write_verbs ;;
  label) write_verbs=$label_write_verbs ;;
  *) write_verbs='' ;;
esac

if [ -z "$write_verbs" ] || ! [[ $verb =~ ^($write_verbs)$ ]]; then
  exec "$real_gh" "$@"
fi

# 値取りフラグの一覧（gh <noun> <verb> --help から起こしたもの）。フラグの読み飛ばしで
# 値取りを boolean と取り違えると、フラグの値を位置引数と誤認して write が素通りする
# （gh repo sync --source owner/repo が典型）ため、推測せず help の記述をそのまま写す。
# issue/pr/release/label は継承フラグの -R/--repo を持つが、
# gh repo edit/delete/archive/unarchive/sync は持たない。
# vf_long は | 区切りの long 名、vf_short は値取り short オプション文字の並び。
vf_long=''
vf_short=''
set_value_flags() {
  case "$1:$2" in
    issue:create)
      vf_long='assignee|body|body-file|label|milestone|project|recover|template|title|repo'
      vf_short='abFlmpTtR' ;;
    issue:comment|pr:comment|pr:review)
      vf_long='body|body-file|repo'
      vf_short='bFR' ;;
    issue:edit)
      vf_long='add-assignee|add-label|add-project|body|body-file|milestone|remove-assignee|remove-label|remove-project|title|repo'
      vf_short='bFmtR' ;;
    issue:close)
      vf_long='comment|reason|repo'
      vf_short='crR' ;;
    issue:reopen|pr:close|pr:reopen)
      vf_long='comment|repo'
      vf_short='cR' ;;
    issue:develop)
      vf_long='base|branch-repo|name|repo'
      vf_short='bnR' ;;
    issue:lock|pr:lock)
      vf_long='reason|repo'
      vf_short='rR' ;;
    pr:create)
      vf_long='assignee|base|body|body-file|head|label|milestone|project|recover|reviewer|template|title|repo'
      vf_short='aBbFHlmprTtR' ;;
    pr:edit)
      vf_long='add-assignee|add-label|add-project|add-reviewer|base|body|body-file|milestone|remove-assignee|remove-label|remove-project|remove-reviewer|title|repo'
      vf_short='BbFmtR' ;;
    pr:merge)
      vf_long='author-email|body|body-file|match-head-commit|subject|repo'
      vf_short='AbFtR' ;;
    pr:revert)
      vf_long='body|body-file|title|repo'
      vf_short='bFtR' ;;
    pr:checkout)
      vf_long='branch|repo'
      vf_short='bR' ;;
    release:create)
      vf_long='discussion-category|notes|notes-file|notes-start-tag|target|title|repo'
      vf_short='nFtR' ;;
    release:edit)
      vf_long='discussion-category|notes|notes-file|tag|target|title|repo'
      vf_short='nFtR' ;;
    label:create)
      vf_long='color|description|repo'
      vf_short='cdR' ;;
    label:edit)
      vf_long='color|description|name|repo'
      vf_short='cdnR' ;;
    repo:edit)
      vf_long='add-topic|default-branch|description|homepage|remove-topic|visibility'
      vf_short='dh' ;;
    repo:sync)
      vf_long='branch|source'
      vf_short='bs' ;;
    repo:rename)
      vf_long='repo'
      vf_short='R' ;;
    repo:*)
      # gh repo delete/archive/unarchive は boolean の --yes だけを持つ
      vf_long=''
      vf_short='' ;;
    *)
      # 残り（issue の unlock/pin/unpin/transfer/delete、pr の unlock/ready/update-branch、
      # release の delete/upload/delete-asset、label の delete/clone）は
      # 継承フラグの -R/--repo だけが値を取る
      vf_long='repo'
      vf_short='R' ;;
  esac
}

takes_value_long() {
  case "|$vf_long|" in
    *"|$1|"*) return 0 ;;
  esac
  return 1
}

takes_value_short() {
  case $vf_short in
    *"$1"*) return 0 ;;
  esac
  return 1
}

set_value_flags "$noun" "$verb"

# 本文を運ぶフラグの一覧（noun:verb ごと）。値取りフラグ表と同じく
# gh <noun> <verb> --help から起こす。short 名は同じ文字でも verb ごとに意味が違う
# （gh issue develop の -b は --base、gh pr checkout / gh repo sync の -b は --branch、
# gh release の -F は --notes-file）ため、「-b が来たら本文」とは判定できない。
# ここに登録した verb の、登録した綴りだけを本文として読む。
# gh release がインライン本文（--notes/-n）を持たない行になっているのは意図的で、
# 移設元のフックが --notes を走査しておらず、足すとルール2・3 が禁じる範囲の拡張に
# なるため。本文ファイル側（--notes-file/-F）は移設元も走査していたので登録する
# （release notes も GitHub でレンダリングされ、素の #N は autolink する）。
body_long=''
body_short=''
body_file_long=''
body_file_short=''
set_body_flags() {
  case "$1:$2" in
    issue:create|issue:comment|issue:edit|pr:create|pr:comment|pr:edit|pr:merge|pr:review|pr:revert)
      body_long='body'
      body_short='b'
      body_file_long='body-file'
      body_file_short='F' ;;
    release:create|release:edit)
      body_file_long='notes-file'
      body_file_short='F' ;;
  esac
}

set_body_flags "$noun" "$verb"

# verb 直後の --help / -h はヘルプ参照で write ではない
next=${3:-}
if [ "$next" = '--help' ]; then
  exec "$real_gh" "$@"
fi
if [ "$next" = '-h' ] && ! takes_value_short h; then
  exec "$real_gh" "$@"
fi

# 判定は Claude Code のセッション内でのみ行う。事故の実例はエージェントが調査目的で
# cd したリポジトリへ書き込む形に限られ、日々のコストを足すガードは無効化されるため
if [ -z "${CLAUDECODE:-}" ]; then
  exec "$real_gh" "$@"
fi

# argv を1回走査して、リポジトリ指定フラグの有無と最初の位置引数を同時に求める。
# GH_REPO はシェルが環境変数割り当てとして消費するため argv には現れない。よって
# コマンド前置か ambient な export かは区別できないが、いずれの場合も gh が解決する
# リポジトリはその値になり cwd 由来の暗黙解決ではないので、明示として扱ってよい
has_repo=0
positional=''
inline_body=''
body_file=''

# 本文フラグの値を控える。set_body_flags が登録した綴りとだけ照合する。
# 照合先を引数で受けるのは、long 名と short 1 文字で参照する登録名が違うため
record_body_value() {
  local name=$1 value=$2 body_name=$3 body_file_name=$4

  if [ -z "$name" ]; then
    return 0
  fi
  if [ "$name" = "$body_name" ]; then
    inline_body=$value
  elif [ "$name" = "$body_file_name" ]; then
    body_file=$value
  fi
}

scan_args() {
  local tok name val rest ch end_of_flags=0

  if [ -n "${GH_REPO:-}" ]; then
    has_repo=1
  fi

  while [ "$#" -gt 0 ]; do
    tok=$1
    shift
    if [ "$end_of_flags" -eq 1 ]; then
      if [ -z "$positional" ]; then
        positional=$tok
      fi
      continue
    fi
    case $tok in
      --)
        end_of_flags=1 ;;
      --*=*)
        name=${tok%%=*}
        if [ "$name" = '--repo' ]; then
          has_repo=1
        fi
        record_body_value "${name#--}" "${tok#*=}" "$body_long" "$body_file_long" ;;
      --*)
        if [ "$tok" = '--repo' ]; then
          has_repo=1
        fi
        if takes_value_long "${tok#--}" && [ "$#" -gt 0 ]; then
          record_body_value "${tok#--}" "$1" "$body_long" "$body_file_long"
          shift
        fi ;;
      -?*)
        # 密着した短オプションの塊（-yd・-Rowner/repo 等）を1文字ずつ解く
        rest=${tok#-}
        while [ -n "$rest" ]; do
          ch=${rest:0:1}
          rest=${rest:1}
          if [ "$ch" = 'R' ]; then
            has_repo=1
          fi
          if takes_value_short "$ch"; then
            # 残りがあれば密着した値、無ければ次のトークンが値。
            # 密着形の先頭 = を1つ落とすのは pflag に合わせるため（-F=x の値は x、
            # -F==x の値は =x）。落とさないと本文ファイルのパスが "=path" になり、
            # 読めない本文として fail open で素通りする
            val=''
            if [ -n "$rest" ]; then
              val=${rest#=}
            elif [ "$#" -gt 0 ]; then
              val=$1
              shift
            fi
            record_body_value "$ch" "$val" "$body_short" "$body_file_short"
            break
          fi
        done ;;
      *)
        if [ -z "$positional" ]; then
          positional=$tok
        fi ;;
    esac
  done
}

shift 2
scan_args "$@"

# 位置引数がリポジトリを指しているか。OWNER/REPO・HOST/OWNER/REPO はスラッシュの
# 個数（1〜2）で bare REPO と区別する。
repo_positional_pattern='^(https?://[^/[:space:]]+/[^/[:space:]]+/[^/[:space:]]+(\.git)?/?|[A-Za-z0-9_.][A-Za-z0-9_.-]*/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)?)$'
issue_url_pattern='^https?://[^/[:space:]]+/[^/[:space:]]+/[^/[:space:]]+/(issues|pull)/[0-9]+/?$'

is_explicit() {
  case "$noun:$verb" in
    repo:rename)
      # 位置引数は新しいリポジトリ名なのでリポジトリの明示には使えない
      [ "$has_repo" -eq 1 ] ;;
    repo:*)
      # -R を持たないため、位置引数だけがリポジトリ明示の手段になる
      [[ $positional =~ $repo_positional_pattern ]] ;;
    issue:create|pr:create)
      # selector を取らないため URL で示す余地がない
      [ "$has_repo" -eq 1 ] ;;
    issue:*|pr:*)
      [ "$has_repo" -eq 1 ] || [[ $positional =~ $issue_url_pattern ]] ;;
    *)
      # release / label の位置引数はタグ名・ラベル名でリポジトリではない
      [ "$has_repo" -eq 1 ] ;;
  esac
}

# 本文中の項番目的とみられる素の #N を数える。GitHub がリンク化しない箇所
# （fenced code block・インラインコード）を除去した上で、単語頭の #1〜#9 の異なり数を返す
count_bare_hash_refs() {
  awk '
    /^[[:space:]]*(```|~~~)/ { fence = !fence; next }
    fence { next }
    {
      gsub(/`[^`]*`/, "")
      for (i = 1; i <= NF; i++) {
        t = $i
        if (t !~ /^[^[:alnum:]#]*#[1-9]([^[:alnum:]]|$)/) continue
        sub(/^[^#]*#/, "", t)
        d = substr(t, 1, 1)
        if (!(d in seen)) { seen[d] = 1; n++ }
      }
    }
    END { print n + 0 }
  '
}

# バッククォート付き closing keyword を検出する。fenced code block 内は行全体を、
# それ以外の行はコードスパン内のみを走査する。GitHub は「keyword（+ 任意の :）+ 空白
# + 参照」の直接隣接のみ解釈するため、検出も同じ隣接形に限定する
has_quoted_closing_keyword() {
  awk '
    function has_kw(s) {
      return s ~ /(^|[^[:alnum:]])(close[sd]?|fix(e[sd])?|resolve[sd]?):?[[:space:]]+([[:alnum:]_.-]+\/[[:alnum:]_.-]+)?#[0-9]+/
    }
    {
      line = tolower($0)
      if (line ~ /^[[:space:]]*(```|~~~)/) { fence = !fence; next }
      if (fence) { if (has_kw(line)) found = 1; next }
      while (match(line, /`[^`]*`/)) {
        if (has_kw(substr(line, RSTART, RLENGTH))) found = 1
        line = substr(line, RSTART + RLENGTH)
      }
    }
    END { exit !found }
  '
}

# %q でクォートするのは、空白を含む引数がそのまま並ぶと再実行できない形になるため。
# 関数なのは、ブロックするときにしか要らない fork を通常経路に足さないため
# （ルール1・ルール2 のメッセージが呼ぶ）
attempted_command() {
  printf 'gh'
  printf ' %q' "${argv_all[@]}"
}

# 本文系ルール（2〜4）。違反していればメッセージを出して exit し、無ければ return する。
# ルール1 のようにフラットに書けないのは、通過後に exec へ抜ける必要があるため
check_body_rules() {
  local body_source='' body_content='' distinct_refs

  # ルール2: 複数行の本文を --body/-b で渡すことを禁止する
  if [[ $inline_body == *$'\n'* ]]; then
    cat >&2 <<EOF
gh の書き込み系サブコマンドで複数行の本文を --body/-b で渡すことは禁止しています。

実行しようとしたコマンド:
  $(attempted_command)

理由:
  --body "\$(...)" と HEREDOC を組み合わせると引用符レイヤが重なり、
  誤ったエスケープ（バッククォート前の不要なバックスラッシュ等）が
  そのまま本文に残る事故が起きます。

対処:
  1. 本文を一時ファイル（scratchpad 等）に Write で書き出す
  2. --body の代わりに --body-file <path> を指定して再実行する
       例: gh pr edit -R owner/repo 123 --body-file /path/to/body.md
EOF
    exit "$block_exit"
  fi

  # ルール3・4 が読む本文。本文ファイルが読めない場合は fail open にする
  # （ファイルはこれから書かれることがあり、読めない本文は走査できない）
  if [ -n "$body_file" ]; then
    if [ "$body_file" != '-' ] && [ -r "$body_file" ] && [ -f "$body_file" ]; then
      body_content=$(<"$body_file")
      body_source="--$body_file_long $body_file"
    fi
  elif [ -n "$inline_body" ]; then
    body_content=$inline_body
    body_source="--$body_long の本文"
  fi

  if [ -z "$body_source" ]; then
    return 0
  fi

  # ルール3: 本文中の項番目的とみられる素の #N
  distinct_refs=$(count_bare_hash_refs <<<"$body_content")
  if [ "$distinct_refs" -ge 3 ]; then
    cat >&2 <<EOF
gh の書き込み系サブコマンドの本文に、項番とみられる素の #N を検出しました
（#1〜#9 のうち ${distinct_refs} 種類）。

検出元: $body_source

理由:
  素の #数字 は GitHub で Issue/PR への自動リンクになるため、項目の
  番号付け（指摘 #1, #2, ...）に使うと、無関係な Issue/PR に参照通知
  （mentioned 表示）が飛ぶ事故が起きます。通知は後から取り消せません。

対処:
  1. 項番が目的の場合: 順序リスト（1. 2. ...）等、# を使わない形式に書き換える
  2. 実際に Issue/PR を参照する意図の場合: OWNER/REPO#N 形式で明示する
       例: 178inaba/dotfiles#3
     （リンクは維持され、このガードにも掛かりません）
EOF
    exit "$block_exit"
  fi

  # ルール4: PR 本文中のバッククォート付き closing keyword
  case "$noun:$verb" in
    pr:create|pr:edit) ;;
    *) return 0 ;;
  esac

  if has_quoted_closing_keyword <<<"$body_content"; then
    cat >&2 <<EOF
PR 本文中に、バッククォート（コードスパン/コードブロック）で囲まれた
GitHub closing keyword（Closes/Fixes/Resolves #N）を検出しました。

検出元: $body_source

理由:
  バッククォートで囲むと GitHub が closing keyword として解釈せず、
  PR をマージしても対象 Issue が自動 close されません（open のまま残る事故）。

対処:
  1. Issue を自動 close する意図の場合: バッククォートを外して生のまま書く
       例: Closes #656
  2. closing keyword を引用・文書化する意図の場合: 実番号を避けて
     プレースホルダに置き換える（例: \`Closes #N\`。番号がなければ検出されません）
EOF
    exit "$block_exit"
  fi
}

if is_explicit; then
  check_body_rules
  exec "$real_gh" "${argv_all[@]}"
fi

# 復旧手順は、通過条件が noun ごとに違うため出現に合わせて出し分ける
# （固定の -R 例だけを出すと、-R を持たない gh repo で「満たせない」と誤解される）
repo_flag_hint='  ※ 現在のディレクトリの remote が正しいと確信できる場合も、
       gh repo view --json nameWithOwner -q .nameWithOwner
     で取得した値を -R に渡して明示する'
case "$noun:$verb" in
  repo:rename)
    recovery="  1. 対象リポジトリを -R owner/repo で明示して再実行する
       例: gh repo rename new-name -R owner/repo
     gh repo rename の位置引数は新しいリポジトリ名で、リポジトリの明示にはなりません。
$repo_flag_hint" ;;
  repo:*)
    recovery="  1. 対象リポジトリを位置引数で明示して再実行する
       例: gh repo $verb owner/repo ...
     形式は OWNER/REPO・HOST/OWNER/REPO・リポジトリ URL のいずれかです。
     bare な REPO は gh が認証ユーザーで補完するため明示になりません。
  2. gh repo $verb に -R/--repo はなく、環境変数によるリポジトリ指定も効きません。
     位置引数はフラグより前でも後ろでも構いません。" ;;
  issue:create|pr:create)
    recovery="  1. 対象リポジトリを -R owner/repo で明示して再実行する
       例: gh $noun create -R owner/repo ...
     create は selector を取らないため、URL でリポジトリを示す形はありません。
$repo_flag_hint" ;;
  issue:*|pr:*)
    # selector を取る verb だけが URL 形を使えるので、create とは別に扱う
    # （create に URL 例を出すと、通らない復旧手順を提示することになる）
    if [ "$noun" = pr ]; then
      url_example='https://github.com/owner/repo/pull/123'
    else
      url_example='https://github.com/owner/repo/issues/123'
    fi
    recovery="  1. 対象リポジトリを -R owner/repo で明示して再実行する
       例: gh $noun $verb -R owner/repo ...
  2. 対象を完全な URL で指定する（URL にリポジトリが含まれます）
       例: gh $noun $verb $url_example ...
     番号のみ・ブランチ名は cwd の remote で解決されるため明示になりません。
$repo_flag_hint" ;;
  *)
    recovery="  1. 対象リポジトリを -R owner/repo で明示して再実行する
       例: gh $noun $verb -R owner/repo ...
$repo_flag_hint" ;;
esac

current_dir=$(pwd)
current_remote=$(git remote get-url origin 2>/dev/null || printf '(取得不可: git リポジトリ外、または origin が未設定)')

cat >&2 <<EOF
gh の書き込み系サブコマンドは、対象リポジトリをコマンド上で明示することを必須としています。

実行しようとしたコマンド:
  $(attempted_command)

明示が確認できなかった箇所: gh $noun $verb
現在の作業ディレクトリ: $current_dir
現在の origin remote: $current_remote

このまま実行すると、上記の origin (もしくは gh が解決する remote) が対象になります。
別リポジトリの調査中などに cwd を取り違えると、意図しないリポジトリに書き込みが行われます。

対処:
$recovery
EOF

exit "$block_exit"
