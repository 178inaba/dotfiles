{
  "respectGitignore": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(gh api user:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo clone:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git clone:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git push)",
      "Bash(git push --force-with-lease)",
      "Bash(git switch:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(go -C go install ./cmd/ccx)",
      "Bash(go build:*)",
      "Bash(go doc:*)",
      "Bash(go env:*)",
      "Bash(go generate:*)",
      "Bash(go get:*)",
      "Bash(go help:*)",
      "Bash(go list:*)",
      "Bash(go mod:*)",
      "Bash(go test:*)",
      "Bash(go tool vet:*)",
      "Bash(go version)",
      "Bash(go vet:*)",
      "Bash(mkdir:*)",
      "Bash(npx @playwright/cli:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(test:*)",
      "Bash(tree:*)",
      "Skill",
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "review": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-op-wait-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-edit-guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/start-caffeinate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/skill-frontmatter-check.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/start-caffeinate.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/start-caffeinate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/subagent-tracker.sh --start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-caffeinate.sh --agent-done"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/subagent-tracker.sh --stop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-caffeinate.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-caffeinate.sh --force"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/subagent-tracker.sh --session-end"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/terminal-bell.sh"
          },
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/slack-notify.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-caffeinate.sh"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/idle-notify.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-caffeinate.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "~/go/bin/ccx statusline",
    "refreshInterval": 5
  },
  "extraKnownMarketplaces": {
    "rdsh": {
      "source": {
        "source": "github",
        "repo": "178inaba/rdsh"
      },
      "autoUpdate": true
    },
    "slio": {
      "source": {
        "source": "github",
        "repo": "178inaba/slio"
      },
      "autoUpdate": true
    },
    "cflio": {
      "source": {
        "source": "github",
        "repo": "178inaba/cflio"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "rdsh@rdsh": true,
    "slio@slio": true,
    "cflio@cflio": true
  },
  "language": "japanese",
  "feedbackSurveyRate": 0,
  "tui": "fullscreen",
  "preferredNotifChannel": "notifications_disabled",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "advisorModel": "fable",
  "outputStyle": "Concise"
}
